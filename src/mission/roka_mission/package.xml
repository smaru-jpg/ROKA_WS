<?xml version="1.0"?>
<package format="3">
  <name>roka_mission</name>
  <version>0.1.0</version>
  <description>ROKA competition mission coordinators for base, sensors, and arm.</description>
  <maintainer email="ryoo@example.com">ryoo</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>roka_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>roka_arm</exec_depend>
  <exec_depend>mission_vision</exec_depend>
  <exec_depend>roka_nav2_bringup</exec_depend>
  <exec_depend>roka_terrain_mapping</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>roka_robot_description</exec_depend>
  <exec_depend>roka_md_driver</exec_depend>
  <exec_depend>roka_imu_driver</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
