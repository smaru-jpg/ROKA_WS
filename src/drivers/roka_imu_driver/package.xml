<?xml version="1.0"?>
<package format="3">
  <name>roka_imu_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble driver for the validated EBIMU-9DOFV5 R3.0a.</description>
  <maintainer email="ryoo@example.com">ryoo</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>roka_robot_description</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
