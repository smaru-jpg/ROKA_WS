Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: 1m 기준격자
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Alpha: 0.20
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 가상 VLP-16 누적 3D 지도
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/map_dense
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 매핑에서 분리한 트랙 주행면
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/surface_3d
      Style: Flat Squares
      Size (Pixels): 3
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Selectable: true
      Value: false
    - Class: rviz_default_plugins/Path
      Name: Xbox 수동 완주 중심경로
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/path_3d
      Line Style: Lines
      Line Width: 0.09
      Color: 0; 220; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Name: 차체 왼쪽 폭
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/vehicle_left
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 220; 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: 차체 오른쪽 폭
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/vehicle_right
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 220; 0
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: 수동 성공·실패 기반 경로 위험도
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/risk
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: 면적 주행가능도 초록·노랑·빨강
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/visual/classes
      Namespaces:
        possible_green: true
        caution_yellow: true
        blocked_red: true
        unobserved_gray: false
        manual_possible_polygon: true
        manual_blocked_polygon: true
        committed_review_polygons: true
        draft_review_polygon: true
      Value: true
    - Class: grid_map_rviz_plugin/GridMap
      Name: 높이 Elevation 선택
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/static_map
      Color Transformer: GridMapLayer
      Color Layer: elevation
      Height Transformer: GridMapLayer
      Height Layer: elevation
      Autocompute Intensity Bounds: true
      Use Rainbow: true
      Show Grid Lines: false
      Alpha: 0.82
      Value: false
    - Class: grid_map_rviz_plugin/GridMap
      Name: 경사 Slope 선택
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/static_map
      Color Transformer: GridMapLayer
      Color Layer: slope_deg
      Height Transformer: GridMapLayer
      Height Layer: elevation
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 65
      Use Rainbow: true
      Invert Rainbow: false
      Show Grid Lines: false
      Alpha: 0.88
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: 가정 SC-PGO 키프레임·루프
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/pose_graph
      Namespaces:
        keyframes: true
        factors: true
      Value: false
  Enabled: true
  Global Options:
    Background Color: 24; 26; 30
    Fixed Frame: map
    Frame Rate: 20
  Name: MuJoCo assumed VLP-16 mapping
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 27.0
      Focal Point:
        X: -3.30
        Y: -6.51
        Z: 0.35
      Name: PK-3A 전체 3D
      Near Clip Distance: 0.01
      Pitch: 0.72
      Yaw: 1.92
      Target Frame: map
      Value: Orbit (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Width: 1600
  Height: 900
  X: 30
  Y: 30
  Hide Left Dock: false
  Hide Right Dock: true
