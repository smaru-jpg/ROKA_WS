Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 30
      Alpha: 0.35
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Live VLP-16
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /velodyne_points
      Style: Flat Squares
      Size (Pixels): 3
      Decay Time: 0.35
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Selectable: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Tracked Leader
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission5/leader_marker
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Leader Breadcrumb Trail
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission5/leader_trail
      Line Style: Lines
      Line Width: 0.06
      Color: 0; 170; 255
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Section5 Obstacles
      Enabled: false
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /mission5/obstacle_points
      Style: Flat Squares
      Size (Pixels): 4
      Decay Time: 0.35
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 80; 50
      Selectable: false
      Value: false
    - Class: rviz_default_plugins/TF
      Name: Sensor TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 26; 30
    Fixed Frame: mission5_odom
    Frame Rate: 30
  Name: Section 5 Leader Follow
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 12
    Focal Point:
      X: 3
      Y: 0
      Z: 0
    Pitch: 0.65
    Yaw: 1.57
    Target Frame: base_footprint
    Value: Orbit (rviz)
