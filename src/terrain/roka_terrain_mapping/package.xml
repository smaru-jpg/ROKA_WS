<?xml version="1.0"?>
<package format="3">
  <name>roka_terrain_mapping</name>
  <version>0.1.0</version>
  <description>CPU 2.5D elevation and traversability mapping for ROKA.</description>
  <maintainer email="ryoo@example.com">ryoo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>filters</depend>
  <depend>geometry_msgs</depend>
  <depend>grid_map_core</depend>
  <depend>grid_map_filters</depend>
  <depend>grid_map_msgs</depend>
  <depend>grid_map_pcl</depend>
  <depend>grid_map_ros</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>roka_robot_description</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
