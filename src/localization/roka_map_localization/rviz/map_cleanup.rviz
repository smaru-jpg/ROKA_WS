Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 30
      Alpha: 0.25
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Original Map (reference)
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_cleanup/original
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 120; 120; 120
      Selectable: false
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Working Map (kept)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_cleanup/working
      Style: Flat Squares
      Size (Pixels): 3
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 80; 220; 120
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Removed Preview
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_cleanup/removed
      Style: Flat Squares
      Size (Pixels): 5
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Selectable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 25; 25; 28
    Fixed Frame: map
    Frame Rate: 15
  Name: Map Cleanup
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/TopDownOrtho
    Angle: 0
    Scale: 20
    Target Frame: map
    Value: TopDownOrtho (rviz)
