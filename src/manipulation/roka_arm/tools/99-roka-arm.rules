SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ATTRS{serial}=="FT78LQH1", SYMLINK+="roka_arm_ttl", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"
