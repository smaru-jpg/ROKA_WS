<?xml version="1.0"?>
<package format="3">
  <name>roka_arm</name>
  <version>0.1.0</version>
  <description>ROKA Dynamixel arm, D435 perception, and box visual-servo runtime.</description>
  <maintainer email="ryoo@example.com">ryoo</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>roka_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>dynamixel_sdk</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>roka_md_driver</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
