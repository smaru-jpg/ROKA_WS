Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: 1m 기준격자
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 30
      Alpha: 0.20
      Value: true
    - Class: rviz_default_plugins/Map
      Name: 저장된 2D 점유지도
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Alpha: 0.30
      Color Scheme: map
      Value: false
    - Class: rviz_default_plugins/Map
      Name: 실시간 3D의 2D 투영(표시 전용)
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/occupancy
      Alpha: 0.24
      Color Scheme: map
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: 경량 FAST-LIO SC-PGO 3D 지도
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/map_3d
      Style: Flat Squares
      Size (Pixels): 4
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Selectable: true
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: 조밀 FAST-LIO SC-PGO 3D 지도
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/map_dense
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 주행경로 연결 지면(벽·가구 제외)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/surface_3d
      Style: Flat Squares
      Size (Pixels): 4
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 현재 등록 스캔
      Enabled: false
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lio/cloud_registered
      Style: Points
      Size (Pixels): 2
      Decay Time: 0.25
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Selectable: false
      Value: false
    - Class: rviz_default_plugins/Path
      Name: 실제 기록 중심경로
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/path_3d
      Line Style: Lines
      Line Width: 0.075
      Color: 0; 220; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Name: 차체 왼쪽 여유선
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/vehicle_left
      Line Style: Lines
      Line Width: 0.035
      Color: 255; 220; 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: 차체 오른쪽 여유선
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/vehicle_right
      Line Style: Lines
      Line Width: 0.035
      Color: 255; 220; 0
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: 실측 위험도(초록-노랑-빨강, 미측정 회색)
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/risk
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: SC-PGO 키프레임과 팩터
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /track_visual/pose_graph
      Namespaces:
        keyframes: true
        factors: true
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: 면적 주행가능도(초록/노랑/빨강)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/visual/classes
      Namespaces:
        possible_green: true
        caution_yellow: true
        blocked_red: true
        unobserved_gray: false
        manual_possible_polygon: true
        manual_blocked_polygon: true
        committed_review_polygons: true
        draft_review_polygon: true
      Value: true
    - Class: grid_map_rviz_plugin/GridMap
      Name: 높이 Elevation 원본(선택)
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/static_map
      Color Transformer: GridMapLayer
      Color Layer: elevation
      Height Transformer: GridMapLayer
      Height Layer: elevation
      Autocompute Intensity Bounds: true
      Use Rainbow: true
      Invert Rainbow: false
      Show Grid Lines: false
      Alpha: 0.82
      Value: false
    - Class: grid_map_rviz_plugin/GridMap
      Name: 경사 Slope 0-45deg(선택)
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/static_map
      Color Transformer: GridMapLayer
      Color Layer: slope_deg
      Height Transformer: GridMapLayer
      Height Layer: elevation
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 45
      Use Rainbow: true
      Invert Rainbow: false
      Show Grid Lines: false
      Alpha: 0.88
      Value: false
    - Class: grid_map_rviz_plugin/GridMap
      Name: 거칠기 Roughness 0-0.12m(선택)
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/static_map
      Color Transformer: GridMapLayer
      Color Layer: roughness
      Height Transformer: GridMapLayer
      Height Layer: elevation
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 0.12
      Use Rainbow: true
      Invert Rainbow: false
      Show Grid Lines: false
      Alpha: 0.88
      Value: false
    - Class: rviz_default_plugins/Path
      Name: FAST-LIO 원시경로(진단)
      Enabled: false
      Topic:
        Value: /lio/path
      Line Style: Lines
      Line Width: 0.025
      Color: 60; 170; 255
      Value: false
    - Class: rviz_default_plugins/Path
      Name: SC-PGO 최적화경로(진단)
      Enabled: false
      Topic:
        Value: /pgo/path
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 70; 220
      Value: false
  Enabled: true
  Global Options:
    Background Color: 24; 26; 30
    Fixed Frame: map
    Frame Rate: 20
  Name: Real track mapping 3D
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Topic: /terrain_review/clicked_point
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 11.0
    Focal Point:
      X: 1.5
      Y: 0
      Z: 0
    Name: 3D Orbit
    Near Clip Distance: 0.01
    Pitch: 0.55
    Yaw: 0.85
    Target Frame: map
    Value: Orbit (rviz)
Window Geometry:
  Width: 1500
  Height: 900
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: true
