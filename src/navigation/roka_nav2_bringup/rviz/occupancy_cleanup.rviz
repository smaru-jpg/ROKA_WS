Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metric Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Alpha: 0.20
      Value: true
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Original 2D Map (reference)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupancy_cleanup/original
      Alpha: 0.35
      Color Scheme: map
      Value: false
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Working 2D Map (editable)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupancy_cleanup/working
      Alpha: 0.72
      Color Scheme: map
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Recorded Mapping Path
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupancy_cleanup/recorded_path
      Line Style: Lines
      Line Width: 0.09
      Color: 0; 220; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Vehicle Left Edge
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupancy_cleanup/vehicle_left
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 210; 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Vehicle Right Edge
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupancy_cleanup/vehicle_right
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 210; 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 34; 38
    Fixed Frame: map
    Frame Rate: 15
  Name: Occupancy Cleanup
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 80
      Target Frame: map
      Value: TopDownOrtho (rviz)
      X: 2.3
      Y: -0.8
Window Geometry:
  Width: 1280
  Height: 800
