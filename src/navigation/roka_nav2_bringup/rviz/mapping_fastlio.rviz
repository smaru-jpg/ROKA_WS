Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 30
      Alpha: 0.35
      Value: true
    - Class: rviz_default_plugins/Map
      Name: 2D Occupancy
      Enabled: true
      Topic:
        Value: /map
      Alpha: 0.45
      Color Scheme: map
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Forward 120deg (display only)
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /mapping/front_120_points
      Style: Flat Squares
      Size (Pixels): 4
      Decay Time: 2.0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Selectable: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: SC-PGO Accumulated Map
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pgo/map
      Style: Flat Squares
      Size (Pixels): 3
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Current Registered Scan
      Enabled: false
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lio/cloud_registered
      Style: Points
      Size (Pixels): 2
      Decay Time: 0.25
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Selectable: false
      Value: false
    - Class: rviz_default_plugins/Path
      Name: FAST-LIO Path
      Enabled: true
      Topic:
        Value: /lio/path
      Line Style: Lines
      Line Width: 0.035
      Color: 0; 220; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Name: SC-PGO Optimized Path
      Enabled: true
      Topic:
        Value: /pgo/path
      Line Style: Lines
      Line Width: 0.055
      Color: 255; 70; 220
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Xbox Driven Path
      Enabled: true
      Topic:
        Value: /track/recorded_path
      Line Style: Lines
      Line Width: 0.075
      Color: 255; 230; 0
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF (debug)
      Enabled: false
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 30; 30; 34
    Fixed Frame: map
    Frame Rate: 20
  Name: Mapping
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 10
    Focal Point:
      X: 0
      Y: 0
      Z: 0.5
    Pitch: 0.55
    Yaw: 0.80
    Target Frame: base_link
    Value: Orbit (rviz)
