Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid 1m
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 24
      Alpha: 0.22
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Growing 2D Map
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Alpha: 0.58
      Color Scheme: map
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR 120deg 5s
      Enabled: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /mapping/front_120_points
      Style: Flat Squares
      Size (Pixels): 3
      Decay Time: 5.0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Selectable: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 원시 VLP16 누적 3D (rosbag)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /replay/raw_accumulated_cloud
      Style: Flat Squares
      Size (Pixels): 3
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: 후처리 주행가능 면적 (초록/노랑/빨강)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/visual/classes
      Namespaces:
        possible_green: true
        caution_yellow: true
        blocked_red: true
        unobserved_gray: false
      Value: true
    - Class: grid_map_rviz_plugin/GridMap
      Name: 경사 Slope 원본 레이어
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/local_map
      Color Transformer: GridMapLayer
      Color Layer: slope
      Height Transformer: GridMapLayer
      Height Layer: elevation
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 45
      Use Rainbow: true
      Invert Rainbow: false
      Show Grid Lines: false
      Alpha: 0.88
      Value: false
    - Class: rviz_default_plugins/Path
      Name: Route Growth cyan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /replay/growing_path_latched
      Line Style: Lines
      Line Width: 0.09
      Color: 0; 220; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Route Final reference
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /replay/final_path
      Line Style: Lines
      Line Width: 0.045
      Color: 140; 140; 150
      Value: false
    - Class: rviz_default_plugins/Path
      Name: Vehicle Left yellow
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /replay/vehicle_left
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 210; 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Vehicle Right yellow
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /replay/vehicle_right
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 210; 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Robot Pose
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Keep: 1
      Shape:
        Alpha: 1
        Axes Length: 0.45
        Axes Radius: 0.04
        Color: 255; 80; 80
        Value: Arrow
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF (debug)
      Enabled: false
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 25; 27; 31
    Fixed Frame: map
    Frame Rate: 20
  Name: Mapping Process Rebuild
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 7
    Focal Point:
      X: 1.2
      Y: 0
      Z: 0.25
    Name: 3D Orbit
    Near Clip Distance: 0.01
    Pitch: 0.65
    Yaw: 0.75
    Target Frame: map
    Value: Orbit (rviz)
Window Geometry:
  Width: 1500
  Height: 900
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
