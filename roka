    printf '[ROKA] LiDAR-IMU 동적 보정 %s차\n' "$calibration_action"
    printf '  1) 실행 후 로봇을 5초 이상 움직이지 마십시오.\n'
    printf '  2) FIELD-CHECK READY 뒤 LB: X=좌우 기울기, Y=오르막·내리막, Z=S회전입니다.\n'
    printf '  3) 터미널의 X/Y/Z 진행률을 각각 100%%까지 올리십시오. 평지 회전만 하면 Z만 증가합니다.\n'
    printf '  4) 100%% 뒤 온라인 refinement가 끝나면 자동 종료됩니다. Ctrl+C를 누르지 마십시오.\n'
    if ! run_filtered "LiDAR-IMU 동적 보정 ${calibration_action}차" \
      ros2 launch roka_fast_lio_localization \
      lidar_imu_dynamic_calibration.launch.py \
      output_dir:="$run_directory" allow_motion:=true \
      joy_device_id:=auto use_rviz:=true; then
      fail "LI-Init 실행이 비정상 종료되었습니다. roka log에서 최초 오류를 확인하십시오."
    fi
    if grep -Eq '^\[ERROR\] \[li_init-[0-9]+\]: process has died|InvalidTopicNameError|terminate called' \
      "$raw_runtime_log"; then
      fail "LI-Init 노드가 비정상 종료되었습니다. roka log에서 최초 오류를 확인하십시오."
    fi
    [[ -s "$run_directory/Initialization_result.txt" ]] || \
      fail "LI-Init 최종 결과가 없습니다. 회전 자극이 부족했거나 중간 종료되었습니다."
    ros2 run roka_fast_lio_localization roka_lidar_imu_calibration \
      --result "$run_directory/Initialization_result.txt" \
      --write-run "$run_directory/result.yaml" || \
      fail "LI-Init 결과 형식/수치 검증에 실패했습니다. roka log 확인"
    if [[ "$calibration_action" == "1" ]]; then
      printf '[ROKA][NEXT] LiDAR와 IMU 전원을 완전히 껐다가 다시 켠 뒤 실행:\n'
      printf '  roka %s calibrate 2\n' "$execution_profile"
    else
      ros2 run roka_fast_lio_localization roka_lidar_imu_calibration \
        --run-1 "$calibration_root/run_1/result.yaml" \
        --run-2 "$calibration_root/run_2/result.yaml" \
        --hardware-config "$hardware_source" \
        --report "$calibration_root/validation.yaml" --apply || \
        fail "1·2차 보정 재현성 기준을 통과하지 못했습니다. 1차부터 다시 측정하십시오."
      printf '[ROKA][NEXT] 보정값이 적용되었습니다. 이제 트랙 매핑 가능:\n'
      printf '  roka %s map section_2\n' "$execution_profile"
    fi
    ;;

  mapping)
    if [[ "$execution_profile" != "capture" ]]; then
      printf '[ROKA][COMPAT] 수집 때 flat/track 선택은 더 이상 필요 없습니다. 권장: roka mapping section_N\n'
