execution_profile=""
command_name="${1:-help}"
legacy_ramp_alias=false
command_already_shifted=false
legacy_command=""
if [[ "$command_name" == "mujoco" ]]; then
  shift
  command_name="mujoco-${1:-help}"
  [[ "$#" -gt 0 ]] && shift
  command_already_shifted=true
elif [[ "$command_name" == "mapping" || "$command_name" == "process" || \
      "$command_name" == "capture" ]]; then
  unified_name="$command_name"
  if [[ "$unified_name" == "capture" ]]; then
    legacy_command="capture"
    unified_name="mapping"
  fi
  shift
  if [[ "${1:-}" == "flat" || "${1:-}" == "track" ]]; then
    # Compatibility only: the old command selected a mapper before recording.
    execution_profile="$1"
    shift
  else
    execution_profile="capture"
  fi
  command_name="$unified_name"
  command_already_shifted=true
elif [[ "$command_name" == "review" || "$command_name" == "auto" ]]; then
  unified_name="$command_name"
  shift
  if [[ "${1:-}" == "flat" || "${1:-}" == "track" ]]; then
    execution_profile="$1"
    shift
  else
    canonical_section="${1:-section_1}"
    canonical_map_mode="${2:-2d}"
    validate_section "$canonical_section"
    case "$canonical_map_mode" in
      2d) execution_profile="flat" ;;
      3d) execution_profile="track" ;;
      *) fail "지도 방식은 2d 또는 3d여야 합니다: $canonical_map_mode" ;;
    esac
    shift $(( $# >= 2 ? 2 : 1 ))
    set -- "$canonical_section" "$@"
  fi
  command_name="$unified_name"
  command_already_shifted=true
elif [[ "$command_name" == "ramp" ]]; then
  # Keep old operator scripts working, but never create a third map tree.
  # Ramp and real-track practice now share the exact track 3D backend/data.
  execution_profile="track"
  legacy_ramp_alias=true
  shift
  command_name="${1:-help}"
elif [[ "$command_name" == "flat" || "$command_name" == "track" ]]; then
  execution_profile="$command_name"
  shift
  command_name="${1:-help}"
fi
if [[ "$command_name" == "map" ]]; then
  legacy_command="map"
  command_name="mapping"
elif [[ "$command_name" == "follow" ]]; then
  legacy_command="follow"
  command_name="auto"
fi
if [[ "$command_name" == "help" || "$command_name" == "--help" || "$command_name" == "-h" ]]; then
  usage
  exit 0
fi
if [[ "$command_name" == "sections" ]]; then
  section_summary
  exit 0
fi
if [[ "$command_name" == "yolo-paths" ]]; then
  yolo_summary
  exit 0
fi
[[ "$command_already_shifted" == true ]] || shift
prepare_environment
if [[ "$execution_profile" == "capture" ]]; then
  active_map_root="$workspace_root/datasets/mapping"
else
  active_map_root="$workspace_root/maps/${execution_profile:-unselected}"
fi
if [[ "$legacy_ramp_alias" == true ]]; then
  printf '[ROKA][COMPAT] ramp는 track 3D 프로필로 통합되었습니다: maps/track 사용\n'
fi
if [[ -n "$legacy_command" ]]; then
  printf '[ROKA][COMPAT] %s는 이전 명령입니다. 새 명령은 roka %s section_N 입니다.\n' \
    "$legacy_command" "$command_name"
fi

# ROS 2 Humble rejects an empty command-line launch assignment such as
# `camera_serial:=`.  Leave the argument out when no camera is explicitly
# selected; the launch file then uses its empty/default serial and RealSense
# selects the connected D435.  Keep this as an array so an unset value expands
# to zero shell arguments instead of one malformed argument.
arm_camera_launch_args=()
if [[ -n "${ROKA_ARM_CAMERA_SERIAL:-}" ]]; then
  arm_camera_launch_args=("camera_serial:=${ROKA_ARM_CAMERA_SERIAL}")
fi
mission_led_launch_args=("enable_led:=false")
if [[ -n "${ROKA_LED_SERIAL:-}" ]]; then
  [[ "$ROKA_LED_SERIAL" == /dev/serial/by-id/* ]] || \
    fail "ROKA_LED_SERIAL은 고정 /dev/serial/by-id 경로여야 합니다."
  mission_led_launch_args=(
    "enable_led:=true"
    "led_serial_port:=${ROKA_LED_SERIAL}"
  )
fi

case "$command_name" in
  mujoco-mapping)
    demonstration="${1:-lap01_2}"
    demonstration="${demonstration%.csv}"
    [[ "$demonstration" =~ ^[a-zA-Z0-9_-]+$ ]] || \
      fail "무조코 수동주행 이름은 영문/숫자/_/-만 허용됩니다: $demonstration"
    success_csv="$workspace_root/datasets/xbox_demonstrations/${demonstration}.csv"
    [[ -f "$success_csv" ]] || fail "수동주행 데이터가 없습니다: $success_csv"
    printf '[ROKA] 무조코 트랙 가정 매핑: 형상=PK-3A, 경로=%s, 가상 VLP-16=전방 120도\n' \
      "$demonstration"
    ros2 run roka_mujoco export_assumed_mapped_track \
      --success-csv "$success_csv" \
      --output-directory "$workspace_root/maps/sim_pk3a_assumed_mapping"
    printf '[ROKA][DONE] 가상 지도: %s/maps/sim_pk3a_assumed_mapping\n' "$workspace_root"
    printf '[ROKA] 확인: roka mujoco review\n'
    ;;

  mujoco-review)
    bundle="$workspace_root/maps/sim_pk3a_assumed_mapping"
    [[ -f "$bundle/simulation_mapping_manifest.yaml" ]] || \
      fail "가상 지도가 없습니다: 먼저 roka mujoco mapping"
    exec ros2 launch roka_mujoco mujoco_assumed_mapping_view.launch.py \
      bundle_directory:="$bundle"
    ;;

  mujoco-help)
    printf 'roka mujoco mapping [lap01_2]  가상 VLP-16 지도 생성\n'
    printf 'roka mujoco review             RViz 결과 확인\n'
    ;;

  verify)
    printf '[ROKA] 소프트웨어 회귀검증(모터 출력 없음)\n'
    verify_log="$report_dir/verify_software.log"
    : > "$verify_log"
    bash -n "$workspace_root/roka"
    (cd "$workspace_root" && sha256sum -c tools/section5_frozen.sha256) \
      >>"$verify_log" 2>&1 || fail "섹션5 동결 파일이 변경되었습니다"
    export PYTHONPATH="$workspace_root/src/common/roka_robot_description:$workspace_root/src/drivers/roka_md_driver:$workspace_root/src/manipulation/roka_arm:$workspace_root/src/mission/roka_mission:$workspace_root/src/mission_vision:$workspace_root/src/navigation/roka_nav2_bringup:$workspace_root/src/localization/roka_fast_lio_localization:${PYTHONPATH:-}"
    /usr/bin/python3 -m pytest -q \
      "$workspace_root/src/common/roka_robot_description/test" \
      "$workspace_root/src/drivers/roka_md_driver/test" \
      "$workspace_root/src/manipulation/roka_arm/test" \
      "$workspace_root/src/mission/roka_mission/test" \
      "$workspace_root/src/mission_vision/test" \
      "$workspace_root/src/navigation/roka_nav2_bringup/test" \
      "$workspace_root/src/localization/roka_fast_lio_localization/test"
    cpp_test_packages=(
      roka_imu_driver
      roka_terrain_supervisor
      roka_terrain_mapping
    )
    for test_package in "${cpp_test_packages[@]}" sc_pgo; do
      # Never aggregate XML left by a previous test environment or interrupted
      # run. colcon/CTest recreate these directories below.
      rm -rf -- \
        "$workspace_root/build/$test_package/test_results" \
        "$workspace_root/build/$test_package/Testing"
    done
    if ! CMAKE_BUILD_PARALLEL_LEVEL=1 MAKEFLAGS=-j1 \
      colcon test --executor sequential --packages-select "${cpp_test_packages[@]}" \
      >>"$verify_log" 2>&1; then
      tail -n 60 "$verify_log" >&2
      fail "C++ IMU/terrain/leader 시험 실패"
    fi
    # SC-PGO is vendored third-party code. Its Flake8 result depends on any
    # globally installed Python linter, while the deployed runtime is C++.
    # Verify the actual loop-constraint implementation and exclude only the
    # upstream development-style linters from the portable handoff contract.
    if ! CMAKE_BUILD_PARALLEL_LEVEL=1 MAKEFLAGS=-j1 \
      colcon test --executor sequential --packages-select sc_pgo \
        --ctest-args -R '^test_loop_constraint$' \
      >>"$verify_log" 2>&1; then
      tail -n 60 "$verify_log" >&2
      fail "SC-PGO C++ 루프제약 시험 실패"
    fi
    cpp_test_packages+=(sc_pgo)
    for test_package in "${cpp_test_packages[@]}"; do
      package_result="$(colcon test-result \
        --test-result-base "$workspace_root/build/$test_package" 2>&1)" || {
        printf '%s\n' "$package_result" >&2
        fail "$test_package 시험 결과 실패"
      }
      printf '[ROKA][VERIFY][%s] %s\n' "$test_package" "$package_result"
    done
    # Parse every first-party real-robot launch, not only the mission wrappers.
    # Vendor and simulation launch files have their own upstream/local tests and
    # are deliberately outside the handoff/runtime contract checked here.
    launch_count=0
    while IFS= read -r launch_file; do
      package_directory="${launch_file%/launch/*}"
      package_name="$(sed -n \
        's:.*<name>\(.*\)</name>.*:\1:p' \
        "$package_directory/package.xml" | head -n 1)"
      [[ -n "$package_name" ]] || fail "런치 패키지 이름 확인 실패: $launch_file"
      ros2 launch "$package_name" "$(basename "$launch_file")" --show-args \
        >>"$verify_log" 2>&1 || \
        fail "런치 인자 검사 실패: $package_name/$(basename "$launch_file")"
      launch_count=$((launch_count + 1))
    done < <(
      find "$workspace_root/src" -path '*/launch/*.launch.py' -type f \
        ! -path "$workspace_root/src/vendor/*" \
        ! -path "$workspace_root/src/simulation/*" | sort
    )
    source_roots=()
    for directory in "$workspace_root"/src/*; do
      [[ -d "$directory" && "$(basename "$directory")" != simulation ]] && \
        source_roots+=("$directory")
    done
    # ament_python is the installed ROS build type used by Python packages,
    # but Ubuntu Jammy's rosdep database does not publish it as a resolvable
    # system key. Package builds above prove that backend separately.
    rosdep check --from-paths "${source_roots[@]}" --ignore-src \
      --skip-keys=ament_python --rosdistro humble >>"$verify_log" 2>&1
    printf '[ROKA][VERIFY][PASS] Python 회귀 + IMU/terrain/leader/SC-PGO C++ + 실차 런치 %s개, rosdep 누락 0\n' \
      "$launch_count"
    ;;

  handoff)
    output_file="${1:-$HOME/Downloads/roka_ws_handoff_$(date +%m%d).zip}"
    python3 "$workspace_root/tools/export_handoff.py" "$output_file"
    ;;

  arm-check)
    require_profile
