#!/usr/bin/env bash
set -Eeo pipefail

launcher_name="$(basename "$0")"
script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_directory="$(cd "$(dirname "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" == /* ]] || \
    script_source="$script_directory/$script_source"
done
workspace_root="$(cd "$(dirname "$script_source")" && pwd)"
export ROKA_WS_ROOT="$workspace_root"
report_dir="$workspace_root/reports"
runtime_log="$report_dir/latest_runtime.log"
raw_runtime_log="$report_dir/latest_runtime.raw.log"
history_log="$report_dir/roka_history.log"
instance_config="${ROKA_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/roka/${launcher_name}.env}"
# One operator-facing ceiling for every map/profile-based autonomous route.
# Section 5 leader following is an independent mission and keeps its explicit
# 0.60--1.20 m/s argument.
mapped_autonomy_speed_mps="0.30"

load_instance_config() {
  [[ -r "$instance_config" ]] || return 0
  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      ROKA_ROS_DOMAIN_ID|ROKA_ARM_CAMERA_SERIAL|ROKA_LED_SERIAL)
        export "$key=$value"
        ;;
      *)
        fail "지원하지 않는 로컬 설정입니다: $key ($instance_config)"
        ;;
    esac
  done <"$instance_config"
}

remove_foreign_ros_paths() {
  local variable="$1" raw entry filtered=""
  raw="${!variable:-}"
  IFS=':' read -r -a entries <<<"$raw"
  for entry in "${entries[@]}"; do
    [[ -z "$entry" ]] && continue
    case "$entry" in
      /opt/ros/*|*/install/*|*/build/*) continue ;;
    esac
    filtered="${filtered:+$filtered:}$entry"
  done
  printf -v "$variable" '%s' "$filtered"
  export "$variable"
}

fail() {
  printf '[ROKA][ERROR] %s\n' "$*" >&2
  exit 2
}

