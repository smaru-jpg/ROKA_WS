    if [[ "$calibration_action" == "1" ]]; then
      archive_run "$calibration_root/run_2"
      if [[ -f "$calibration_root/validation.yaml" ]]; then
        mkdir -p "$archive_root"
        mv -- "$calibration_root/validation.yaml" \
          "$archive_root/${archive_stamp}_validation.yaml"
