  calibrate)
    require_profile
    [[ "$execution_profile" == "track" ]] || \
      fail "LiDAR-IMU 동적 보정은 3D 매핑 준비용입니다: roka track calibrate 1"
    calibration_action="${1:-status}"
    calibration_replay_run="${2:-1}"
    calibration_root="$report_dir/lidar_imu_calibration"
    hardware_source="$workspace_root/src/common/roka_robot_description/config/pk3a_hardware.yaml"
    mkdir -p "$calibration_root"
    if [[ "$calibration_action" == "status" ]]; then
      printf '[ROKA] LiDAR-IMU 동적 보정 상태\n'
      grep -nE \
        'rotation_source:|temporal_source:|rotation_validated_dynamically:|temporal_offset_validated_dynamically:|time_offset_lidar_to_imu_sec:|validated_at_utc:' \
        "$hardware_source" || true
      print_dynamic_calibration_summary || true
      exit 0
    fi
    if [[ "$calibration_action" == "replay" ]]; then
      [[ "$calibration_replay_run" == "1" || "$calibration_replay_run" == "2" ]] || \
        fail "재처리 회차는 1 또는 2여야 합니다: $calibration_replay_run"
      recorded_run="$calibration_root/run_${calibration_replay_run}"
      recorded_bag="$recorded_run/sensors"
      [[ -s "$recorded_bag/metadata.yaml" ]] || \
        fail "재처리할 센서 rosbag이 없습니다: $recorded_bag"
      replay_output="$calibration_root/reprocessed_run_${calibration_replay_run}"
      if [[ -e "$replay_output" ]]; then
        mkdir -p "$calibration_root/archive"
        mv -- "$replay_output" \
          "$calibration_root/archive/$(date +%Y%m%d_%H%M%S)_reprocessed_run_${calibration_replay_run}"
      fi
      printf '[ROKA] 저장 rosbag으로 LiDAR-IMU %s차 보정 재처리\n' "$calibration_replay_run"
      printf '[ROKA] 원본 기록은 보존하며 차륜형 목표 6%%, 최소 누적 60초를 적용합니다.\n'
      if ! run_filtered "LiDAR-IMU 저장 데이터 ${calibration_replay_run}차 재처리" \
        ros2 launch roka_fast_lio_localization lidar_imu_bag_calibration.launch.py \
        bag:="$recorded_bag" output_dir:="$replay_output" \
        required_excitation_fraction:=0.06 \
        minimum_accumulation_duration_sec:=60.0 replay_rate:=1.0; then
        fail "저장 데이터 LI-Init 재처리가 비정상 종료되었습니다. roka log 확인"
      fi
      [[ -s "$replay_output/Initialization_result.txt" ]] || \
        fail "저장 데이터가 조정된 3축 관측성 기준을 충족하지 못했습니다. 원본 rosbag은 유지됩니다."
      ros2 run roka_fast_lio_localization roka_lidar_imu_calibration \
        --result "$replay_output/Initialization_result.txt" \
        --write-run "$replay_output/result.yaml" || \
        fail "재처리된 LI-Init 결과 형식/수치 검증에 실패했습니다."
      cp -- "$replay_output/Initialization_result.txt" "$recorded_run/Initialization_result.txt"
      cp -- "$replay_output/result.yaml" "$recorded_run/result.yaml"
      printf '[CALIBRATION][CANDIDATE] %s차 배치 초기해를 %s에 저장했습니다.\n' \
        "$calibration_replay_run" "$recorded_run/result.yaml"
      if [[ "$calibration_replay_run" == "2" && -s "$calibration_root/run_1/result.yaml" ]]; then
        ros2 run roka_fast_lio_localization roka_lidar_imu_calibration \
          --run-1 "$calibration_root/run_1/result.yaml" \
          --run-2 "$calibration_root/run_2/result.yaml" \
          --hardware-config "$hardware_source" \
          --report "$calibration_root/validation.yaml" --apply || \
          fail "1·2차 보정 재현성 기준을 통과하지 못했습니다."
      else
        printf '[ROKA][NEXT] 독립된 2차 기록이 필요합니다: roka %s calibrate 2\n' \
          "$execution_profile"
      fi
      exit 0
    fi
    ensure_arm_motion_is_not_running
    ensure_base_is_not_running
    [[ "$calibration_action" == "1" || "$calibration_action" == "2" ]] || \
      fail "보정 회차는 1, 2 또는 status여야 합니다: $calibration_action"
    if [[ "$calibration_action" == "2" && ! -s "$calibration_root/run_1/result.yaml" ]]; then
      fail "1차 보정 결과가 없습니다: 먼저 roka track calibrate 1"
    fi
    archive_root="$calibration_root/archive"
    archive_stamp="$(date +%Y%m%d_%H%M%S)"
    archive_run() {
      local target="$1"
      if [[ -e "$target" ]]; then
        mkdir -p "$archive_root"
        mv -- "$target" "$archive_root/${archive_stamp}_$(basename "$target")"
      fi
    }
    run_directory="$calibration_root/run_${calibration_action}"
    archive_run "$run_directory"
