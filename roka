  esac
}

record_event() {
  printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" >> "$history_log"
}

run_filtered() {
  local label="$1"
  local interrupted=0
  shift
  : > "$runtime_log"
  : > "$raw_runtime_log"
  printf '[ROKA] %s | 핵심 로그: %s\n' "$label" "$runtime_log" | \
    tee -a "$runtime_log"
  record_event "start $label"
  trap 'interrupted=1' INT
  set +e
  stdbuf -oL -eL "$@" 2>&1 | \
    tee -i "$raw_runtime_log" | \
    python3 -u "$workspace_root/tools/roka_log_filter.py" | \
    tee -i -a "$runtime_log"
  local pipeline_status=("${PIPESTATUS[@]}")
  set -e
  trap - INT
  local command_status="${pipeline_status[0]}"
  # Some launch guards intentionally emit a Shutdown event after printing a
  # launch-level error. ROS 2 then exits with status 0 even though no node was
  # started. Treat those guard messages as failures so callers do not print
  # DONE or continue into map/status checks for products that cannot exist.
  if [[ "$command_status" -eq 0 && -s "$raw_runtime_log" ]] && \
     ! grep -q '^\[PROCESS\]\[RESULT\] COMPLETE' "$raw_runtime_log" && \
     grep -Eq '^\[ERROR\] \[(pk3a_field|launch)\]:|^\[ERROR\] \[[^]]+-[0-9]+\]: process has died|InvalidTopicNameError' \
       "$raw_runtime_log"; then
    command_status=1
  fi
  if [[ "$interrupted" -eq 1 || "$command_status" -eq 130 || "$command_status" -eq 120 ]]; then
    command_status=130
    printf '[ROKA][STOP] %s 사용자 중지\n' "$label" | tee -a "$runtime_log"
    record_event "finish $label result=STOPPED"
  elif [[ "$command_status" -eq 0 ]]; then
    printf '[ROKA][DONE] %s 정상 종료\n' "$label" | tee -a "$runtime_log"
    record_event "finish $label result=PASS"
  else
    printf '[ROKA][ERROR] %s 실패(exit=%s). roka log 확인\n' \
      "$label" "$command_status" | tee -a "$runtime_log" >&2
    if [[ -s "$raw_runtime_log" ]]; then
      printf '[ROKA][DETAIL] 필터 전 원본 로그의 마지막 출력:\n' | \
        tee -a "$runtime_log" >&2
      tail -n 20 "$raw_runtime_log" | tee -a "$runtime_log" >&2
      printf '[ROKA][DETAIL] 전체 원본 로그: %s\n' "$raw_runtime_log" | \
        tee -a "$runtime_log" >&2
    fi
    record_event "finish $label result=FAIL exit=$command_status"
  fi
  return "$command_status"
}

