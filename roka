  [[ "$1" =~ ^section_[1-5]$ ]] || \
    fail "map id는 section_1부터 section_5까지만 허용됩니다: $1"
}

dynamic_calibration_ready() {
  local hardware_source="$workspace_root/src/common/roka_robot_description/config/pk3a_hardware.yaml"
  [[ -r "$hardware_source" ]] && \
    grep -Eq '^[[:space:]]*rotation_validated_dynamically:[[:space:]]*true[[:space:]]*$' \
      "$hardware_source" && \
    grep -Eq '^[[:space:]]*temporal_offset_validated_dynamically:[[:space:]]*true[[:space:]]*$' \
      "$hardware_source"
}

print_dynamic_calibration_summary() {
  local calibration_root="$report_dir/lidar_imu_calibration"
  local profile="${execution_profile:-track}"
  local calibration_running=false
  if pgrep -f 'lidar_imu_dynamic_calibration.launch.py' >/dev/null 2>&1; then
    calibration_running=true
    printf '[CALIBRATION][RUNNING] 동적 보정이 실행 중입니다. 현재 터미널에서 Ctrl+C를 누르지 마십시오.\n'
  fi
  if dynamic_calibration_ready; then
    if [[ -s "$calibration_root/offline_regression.yaml" ]] && \
       grep -Eq '^result:[[:space:]]*FAIL[[:space:]]*$' \
         "$calibration_root/offline_regression.yaml"; then
      printf '[CALIBRATION][CONDITIONAL] 2회 재현성은 PASS지만 저장 평지 bag의 3D Z 드리프트 기준은 FAIL\n'
      printf '[CALIBRATION][REQUIRED] 매핑 시작 전 FAST-LIO stationary PASS, 저장 후 roka track check가 필요합니다.\n'
      printf '[CALIBRATION][REGRESSION] %s\n' \
        "$calibration_root/offline_regression.yaml"
    else
      printf '[CALIBRATION][PASS] LiDAR-IMU 회전·시간 오프셋 2회 재현성 검증 완료\n'
    fi
    [[ -s "$calibration_root/validation.yaml" ]] && \
      printf '[CALIBRATION][REPORT] %s\n' "$calibration_root/validation.yaml"
    return 0
  fi
  if [[ -s "$calibration_root/run_1/result.yaml" ]]; then
    printf '[CALIBRATION][CANDIDATE] 1차 LI-Init 배치 초기해 있음(아직 실차 설정 미반영)\n'
    if grep -Eq '^[[:space:]]*stable:[[:space:]]*false[[:space:]]*$' \
        "$calibration_root/run_1/result.yaml"; then
      printf '[CALIBRATION][WARN] 온라인 refinement 발산 감지; 배치 초기해만 2차 재현성 검증에 사용\n'
    fi
  elif [[ "$calibration_running" == true ]]; then
    printf '[CALIBRATION][PENDING] 1차 실행 중; 조정 목표 기준 X/Y/Z 100%%와 자동 종료를 기다리는 중\n'
  elif [[ -e "$calibration_root/run_1/Initialization_result.txt" ]]; then
    printf '[CALIBRATION][INCOMPLETE] 1차 결과가 0바이트입니다. 조정 목표 기준 X/Y/Z 100%% 전에 종료됐습니다.\n'
  else
    printf '[CALIBRATION][MISSING] 1차 결과 없음\n'
  fi
  if [[ -s "$calibration_root/run_2/result.yaml" ]]; then
    printf '[CALIBRATION][CANDIDATE] 2차 LI-Init 배치 초기해 있음\n'
  else
    printf '[CALIBRATION][MISSING] 2차 결과 없음\n'
  fi
  if [[ "$calibration_running" == true ]]; then
    printf '[CALIBRATION][NEXT] 현재 보정 터미널에서 계속 진행하십시오. 새 보정을 중복 실행하지 마십시오.\n'
  elif [[ -s "$calibration_root/run_1/result.yaml" ]]; then
    printf '[CALIBRATION][NEXT] LiDAR·IMU 전원 재인가 후 독립 2차 실행: roka %s calibrate 2\n' "$profile"
  else
    printf '[CALIBRATION][NEXT] %s\n' "roka $profile calibrate 1"
  fi
  printf '[CALIBRATION][MOTION] 차륜형 목표는 원본 LI-Init의 6%%; 화면은 이 조정 목표를 100%%로 환산 표시\n'
  printf '[CALIBRATION][MOTION] X=좌우 기울기, Y=오르막·내리막, Z=S회전; 세 축 완료 후 자동 종료\n'
  return 1
}

