      printf '[ROKA] %s 수동 매핑 시작: %s (%s)\n' \
        "$(profile_label)" "$section" "$environment"
      mapping_label="$(profile_label) 수동 매핑"
    fi
    printf '[ROKA] Y로 매핑버튼 활성화, A로 기록 시작, LB+스틱 주행, B로 저장합니다.\n'
    printf '[ROKA] 저장 완료 후에도 팔 시작자세 토크 고정과 LB 수동주행이 유지됩니다.\n'
    printf '[ROKA] 저장 후 종료하려면 LB를 놓고 B를 한 번 더 누르십시오.\n'
    map_metadata_file="$active_map_root/$section/metadata.yaml"
    map_metadata_before="$(stat -c '%y:%s' "$map_metadata_file" 2>/dev/null || true)"
    map_run_status=0
