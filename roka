prepare_environment() {
  [[ -r /opt/ros/humble/setup.bash ]] || fail "ROS 2 Humble을 찾을 수 없습니다."
  [[ -r "$workspace_root/install/setup.bash" ]] || \
    fail "install/setup.bash가 없습니다. 먼저 워크스페이스를 빌드하십시오."
  load_instance_config
  local selected_domain="${ROKA_ROS_DOMAIN_ID:-31}"
  [[ "$selected_domain" =~ ^[0-9]+$ ]] && \
    ((selected_domain >= 0 && selected_domain <= 232)) || \
    fail "ROKA_ROS_DOMAIN_ID는 0~232여야 합니다: $selected_domain"
  cd "$workspace_root"
  # A receiver may already have sourced another workspace containing the same
  # package names. Remove all inherited ROS/colcon indexes before selecting the
  # Humble underlay and this exact ROKA install.
  unset AMENT_PREFIX_PATH COLCON_PREFIX_PATH CMAKE_PREFIX_PATH ROS_PACKAGE_PATH
  unset ROS_DISTRO ROS_VERSION ROS_PYTHON_VERSION PYTHONPATH
  export PYTHONNOUSERSITE=1
  # Prefer Ubuntu/ROS tools over unrelated pip-installed copies in ~/.local.
  # ROS setup below prepends /opt/ros/humble/bin afterwards.
  export PATH="/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin:$HOME/.local/bin"
  remove_foreign_ros_paths PATH
  remove_foreign_ros_paths LD_LIBRARY_PATH
  remove_foreign_ros_paths PKG_CONFIG_PATH
  # shellcheck disable=SC1091
  source /opt/ros/humble/setup.bash
  # shellcheck disable=SC1091
  source "$workspace_root/install/setup.bash"
  export ROS_DOMAIN_ID="$selected_domain"
  if [[ -d "$workspace_root/.roka_python" ]]; then
    export PYTHONPATH="$workspace_root/.roka_python${PYTHONPATH:+:$PYTHONPATH}"
  fi
  python3 "$workspace_root/tools/check_overlay.py" \
    --workspace "$workspace_root" --quiet || \
    fail "다른 ROS 워크스페이스가 ROKA 패키지를 가리고 있습니다."
  # Child Python nodes (notably the Dynamixel driver) also use plain print()
  # for register-level diagnostics.  Flush those lines immediately so an
  # early launch shutdown cannot hide the actual motor/port failure.
  export PYTHONUNBUFFERED=1
  mkdir -p "$report_dir"
}

ensure_arm_motion_is_not_running() {
  local nodes
  nodes="$(timeout 3 ros2 node list 2>/dev/null || true)"
  if grep -qx '/roka_manual_arm_joy' <<< "$nodes"; then
    fail "로봇팔 수동조작이 이미 실행 중입니다. 기존 manual 터미널을 종료하십시오."
  fi
  if grep -qx '/roka_arm_hold' <<< "$nodes"; then
    fail "로봇팔 주행 잠금이 이미 실행 중입니다. 기존 주행 터미널을 종료하십시오."
  fi
  if grep -qx '/roka_arm_controller' <<< "$nodes"; then
    local motion
    motion="$(timeout 3 ros2 param get /roka_arm_controller enable_motion 2>/dev/null || true)"
    if grep -q 'True' <<< "$motion"; then
      fail "로봇팔 구동 모드가 실행 중입니다. 팔을 종료·수납한 뒤 베이스를 주행하십시오."
    fi
  fi
}

ensure_base_is_not_running() {
  local nodes
  nodes="$(timeout 3 ros2 node list 2>/dev/null || true)"
  if grep -qx '/roka_md_driver' <<< "$nodes"; then
    fail "베이스 MD 드라이버가 이미 실행 중입니다. 기존 주행 터미널을 종료하십시오."
  fi
}

ensure_mission_runtime_is_not_running() {
  local nodes collision
  nodes="$(timeout 3 ros2 node list 2>/dev/null || true)"
  collision="$(grep -E '^/(mission_vision|mission_neopixel|roka_arm_controller|roka_manual_arm_joy|box_pick_coordinator|blind_segment_controller|section5_leader_follower|section5_field_preflight|pk3a_field_preflight|roka/arm_camera(/arm_camera)?)$' <<< "$nodes" || true)"
  if [[ -n "$collision" ]]; then
    fail "이전 미션/카메라 노드가 아직 실행 중입니다. 기존 터미널을 종료하십시오: $(tr '\n' ' ' <<< "$collision")"
  fi
}

