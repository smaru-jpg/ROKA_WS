      ros2 launch roka_nav2_bringup pk3a_field.launch.py \
      mode:=mapping environment:="$environment" map_id:="$section" \
      map_root:="$active_map_root" \
      overwrite_existing:=true md_allow_motion:=true joy_device_id:=auto || \
      map_run_status=$?
    map_metadata_after="$(stat -c '%y:%s' "$map_metadata_file" 2>/dev/null || true)"
    if [[ "$execution_profile" == "flat" && \
          "$map_metadata_after" != "$map_metadata_before" && \
          -s "$active_map_root/$section/occupancy.yaml" && \
          -s "$active_map_root/$section/track_profile.yaml" ]]; then
      if [[ -f "$active_map_root/$section/occupancy_review.yaml" ]]; then
        flat_approval=""
      else
        flat_approval="--approve-original"
      fi
      printf '[ROKA] 평지 원본 지도 승인·기록 경로 준비를 자동 수행합니다.\n'
      if prepare_recorded "$section" "$mapped_autonomy_speed_mps" "$flat_approval"; then
        printf '[ROKA][READY] 평지 지도와 직접 기록경로 준비 완료: %s\n' "$section"
        map_run_status=0
      else
        printf '[ROKA][WARN] 지도는 저장됐지만 자동 승인/경로 준비가 실패했습니다. roka flat check %s 확인\n' \
          "$section" >&2
      fi
    fi
    if [[ "$execution_profile" == "capture" ]]; then
      if [[ "$map_metadata_after" != "$map_metadata_before" ]]; then
        printf '[ROKA][READY] 원본 저장 완료: %s\n' "$active_map_root/$section"
        printf '[ROKA][NEXT] roka process %s all\n' "$section"
      fi
    else
      print_status "$section" map || true
    fi
