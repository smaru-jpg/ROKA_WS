    # function.  Preserve the launch exit status without triggering Bash's
    # misleading "return: can only return from a function" error.
    [[ "$map_run_status" -eq 0 ]] || exit "$map_run_status"
    ;;

  process)
    section="${1:-section_1}"
    process_mode="${2:-all}"
    playback_rate="${3:-1.0}"
    validate_section "$section"
    case "$process_mode" in
      audit|2d|3d|all) ;;
      *) fail "처리 모드는 audit, 2d, 3d 또는 all이어야 합니다: $process_mode" ;;
    esac
    if [[ "$execution_profile" == "capture" ]]; then
      if [[ "$process_mode" == "3d" || "$process_mode" == "all" ]]; then
        execution_profile="track"
        require_dynamic_calibration_ready
        execution_profile="capture"
      fi
      source_bundle="$workspace_root/datasets/mapping/$section"
      [[ -f "$source_bundle/sensors/metadata.yaml" ]] || \
        fail "원본 매핑 데이터가 없습니다: 먼저 roka mapping $section"
      printf '[ROKA] 같은 원본 bag으로 지도 생성: %s, mode=%s (실차·모터 비구동)\n' \
        "$section" "$process_mode"
      run_filtered "오프라인 지도 처리 ${section}/${process_mode}" \
        ros2 run roka_nav2_bringup offline_session_processor \
        "$source_bundle" --mode "$process_mode" \
        --playback-rate "$playback_rate" \
        --output-2d "$workspace_root/maps/flat" \
        --output-3d "$workspace_root/maps/track"
    else
      printf '[ROKA][COMPAT] 이전 프로필 원본 재처리: %s/%s, mode=%s\n' \
        "$execution_profile" "$section" "$process_mode"
      run_filtered "오프라인 지도 처리 ${execution_profile}/${section}" \
        ros2 run roka_nav2_bringup offline_session_processor \
        "$active_map_root/$section" --mode "$process_mode" \
        --playback-rate "$playback_rate"
    fi
    ;;

  prepare|prepare-cleaned)
    require_profile
    section="${1:-section_1}"
    speed="${2:-$mapped_autonomy_speed_mps}"
    validate_section "$section"
    [[ "$speed" =~ ^[0-9]+([.][0-9]+)?$ ]] || \
      fail "속도는 0 이상의 숫자여야 합니다: $speed"
    if [[ "$command_name" == "prepare-cleaned" ]]; then
      approval_flag="--approve-cleaned"
      approval_name="편집 지도"
    else
      approval_flag="--approve-original"
      approval_name="원본 지도"
    fi
    printf '[ROKA] %s 승인 후 시험 경로 준비: %s, 최고속도 %s m/s\n' \
      "$approval_name" "$section" "$speed"
    prepare_test "$section" "$speed" "$approval_flag"
    print_status "$section" test
    ;;

  auto)
    require_profile
    section="${1:-section_1}"
    route_mode="${2:-recorded}"
    validate_section "$section"
    if [[ "$section" == "section_2" ]]; then
      printf '[ROKA][MODE] auto는 비전·로봇팔 없이 저장 경로만 자율주행합니다. 박스 미션은 mission2를 사용하십시오.\n'
    fi
    ensure_arm_motion_is_not_running
    ensure_base_is_not_running
    case "$route_mode" in
      test) test_mode=true ;;
      full)
        [[ "$execution_profile" == "track" ]] || \
          fail "full은 3D 경사 프로필 전용입니다. 평지는 recorded 또는 test를 사용하십시오."
        test_mode=false
        ;;
      recorded) test_mode=false ;;
      *) fail "경로 모드는 recorded, test 또는 full이어야 합니다: $route_mode" ;;
    esac
    if [[ "$route_mode" == "recorded" ]]; then
      review_file="$active_map_root/$section/occupancy_review.yaml"
      if [[ -f "$review_file" ]]; then
        recorded_approval=""
        printf '[ROKA] 기존 지도 승인 유지·기록 경로 전체 준비: %s\n' "$section"
      else
        recorded_approval="--approve-original"
        printf '[ROKA] 원본 지도 자동 승인·기록 경로 전체 준비: %s\n' "$section"
      fi
      prepare_output="$(prepare_recorded "$section" "$mapped_autonomy_speed_mps" "$recorded_approval" 2>&1)" || {
        printf '%s\n' "$prepare_output" >&2
        fail "기록 경로 추종 준비 검사 실패"
      }
      printf '%s\n' "$prepare_output" | \
        awk '/\[MAP-CHECK\]\[PASS\]|\[MAP-CHECK\]\[FAIL\]|\[MAP-CHECK\]\[RESULT\]/'
    elif [[ "$route_mode" == "test" ]]; then
      review_file="$active_map_root/$section/occupancy_review.yaml"
      if [[ -f "$review_file" ]]; then
        auto_approval=""
        printf '[ROKA] 기존 지도 승인 유지·시험 경로·저장 데이터 검사: %s\n' \
          "$section"
      else
        auto_approval="--approve-original"
        printf '[ROKA] 원본 지도 자동 승인·시험 경로·저장 데이터 검사: %s\n' \
          "$section"
      fi
      prepare_output="$(prepare_test "$section" "$mapped_autonomy_speed_mps" "$auto_approval" 2>&1)" || {
        printf '%s\n' "$prepare_output" >&2
        fail "자율주행 준비 검사 실패"
      }
      printf '%s\n' "$prepare_output" | \
        awk '/\[MAP-CHECK\]\[FAIL\]|\[MAP-CHECK\]\[RESULT\]/'
      print_status "$section" test
    else
      review_file="$active_map_root/$section/occupancy_review.yaml"
      cleaned_map="$active_map_root/$section/occupancy_cleaned.yaml"
      if [[ -f "$review_file" ]]; then
        full_approval=""
        printf '[ROKA] 기존 지도 승인 유지·3D 안전 경로 재생성: %s\n' \
          "$section"
      elif [[ -f "$cleaned_map" ]]; then
        full_approval="--approve-cleaned"
        printf '[ROKA] 편집 지도 승인·3D 안전 경로 생성: %s\n' \
          "$section"
      else
        fail "full 주행 전 지도 검토가 필요합니다: roka track review $section 후 roka track save-review"
      fi
      prepare_output="$(prepare_full "$section" "$mapped_autonomy_speed_mps" "$full_approval" 2>&1)" || {
        printf '%s\n' "$prepare_output" >&2
        fail "3D 차량 폭·경사 안전 경로 준비 검사 실패"
      }
      printf '%s\n' "$prepare_output" | \
        awk '/\[MAP-CHECK\]\[PASS\]|\[MAP-CHECK\]\[FAIL\]|\[MAP-CHECK\]\[RESULT\]/'
    fi
    run_filtered "$(profile_label) 자율주행 $section ($route_mode)" \
      ros2 launch roka_nav2_bringup pk3a_field.launch.py \
      mode:=autonomy map_id:="$section" test_mode:="$test_mode" \
      map_root:="$active_map_root" \
      recorded_route_mode:="$([[ "$route_mode" == "recorded" ]] && printf true || printf false)" \
      localization_backend:=auto md_allow_motion:=true \
      autonomy_auto_start:=true joy_device_id:=auto \
      competition_track_mode:="$(profile_competition_mode)"
    ;;

  check|status)
    require_profile
    section="${1:-section_1}"
    validate_section "$section"
    print_status "$section" recorded
    ;;

  log)
    if [[ -s "$runtime_log" ]]; then
      tail -n 120 "$runtime_log"
      if [[ -s "$raw_runtime_log" ]]; then
        printf '[ROKA] 필터 전 원본 로그: %s\n' "$raw_runtime_log"
      fi
      printf '[ROKA] 구조화 상태: %s/latest_status.yaml\n' "$report_dir"
    else
      fail "최근 실행 로그가 없습니다"
    fi
    ;;

  review)
    require_profile
    section="${1:-section_1}"
    radius="${2:-0.20}"
    validate_section "$section"
    [[ "$radius" =~ ^[0-9]+([.][0-9]+)?$ ]] || \
      fail "편집 반경은 0 이상의 숫자여야 합니다: $radius"
    if [[ "$execution_profile" == "track" ]]; then
      printf '[ROKA] 3D PCD+경로+차체 폭+경사 판정 표시\n'
      printf '[ROKA] 영역 지정: roka track terrain-mode possible|blocked, 저장: roka track terrain-save\n'
      exec ros2 launch roka_nav2_bringup track_map_view.launch.py \
        bundle_directory:="$active_map_root/$section"
    else
      printf '[ROKA] 청록=기록경로, 노랑=실차 폭, Publish Point 클릭=지도 지우기\n'
      printf '[ROKA] 다른 터미널: roka flat undo-review | reset-review | save-review\n'
      exec ros2 launch roka_nav2_bringup occupancy_cleanup_review.launch.py \
        map_directory:="$active_map_root/$section" clear_radius_m:="$radius"
    fi
    ;;

  replay)
    require_profile
    section="${1:-section_1}"
    replay_mode="${2:-result}"
    playback_rate="${3:-1.0}"
    validate_section "$section"
    replay_directory="$active_map_root/$section"
    if [[ ! -f "$replay_directory/sensors/metadata.yaml" && \
          "$execution_profile" == "track" && \
          -f "$active_map_root/.staging/$section/sensors/metadata.yaml" ]]; then
      replay_directory="$active_map_root/.staging/$section"
      printf '[ROKA][WARN] 정식 승인 지도 없음; staging rosbag/지도만 진단 재생합니다. 자율주행에는 사용되지 않습니다.\n'
    fi
    case "$replay_mode" in
      result|saved) replay_launch="recorded_mapping_view.launch.py" ;;
      process|rebuild) replay_launch="recorded_mapping_rebuild.launch.py" ;;
      *) fail "재생 모드는 result 또는 process여야 합니다: $replay_mode" ;;
    esac
    [[ "$playback_rate" =~ ^[0-9]+([.][0-9]+)?$ ]] || \
      fail "재생 배속은 0보다 큰 숫자여야 합니다: $playback_rate"
    awk -v rate="$playback_rate" 'BEGIN {exit !(rate > 0.0 && rate <= 4.0)}' || \
      fail "재생 배속은 0보다 크고 4.0 이하여야 합니다: $playback_rate"
    if [[ "$replay_mode" == "result" || "$replay_mode" == "saved" ]]; then
      printf '[ROKA] 완성 지도+Terrain+경로+3D LiDAR 1회 재생: %s (모터 비구동)\n' \
        "$section"
      printf '[ROKA] 재생 종료 뒤 화면은 유지됩니다. 초록=가능, 노랑=주의, 빨강=불가, 청록=기록경로\n'
      printf '[ROKA] RViz 그룹: SCANS / MAPS / TRAJECTORIES / TERRAIN / REVIEW\n'
      printf '[ROKA] 다각형 주석: roka %s terrain-mode possible|blocked -> Publish Point 3개 이상 -> terrain-commit\n' \
        "$execution_profile"
    else
      printf '[ROKA] rosbag으로 빈 지도부터 매핑 과정 재구성: %s, %sx (모터 비구동)\n' \
        "$section" "$playback_rate"
      printf '[ROKA] 센서 bag 종료 뒤 화면은 유지됩니다. 확인 후 Ctrl+C로 종료하십시오.\n'
    fi
    replay_database="$replay_directory/sensors/sensors_0.db3"
    replay_database_existed=false
    [[ -f "$replay_database" ]] && replay_database_existed=true
    cleanup_replay_database() {
      if [[ "$replay_database_existed" == false && -f "$replay_database" ]]; then
        rm -f -- "$replay_database"
        printf '[ROKA] 재생용 임시 DB 삭제: %s\n' "$replay_database"
      fi
    }
    trap cleanup_replay_database EXIT
    replay_status=0
    ros2 launch roka_nav2_bringup "$replay_launch" \
      map_directory:="$replay_directory" \
      playback_rate:="$playback_rate" || replay_status=$?
    exit "$replay_status"
    ;;

  view)
    require_profile
    section="${1:-section_1}"
    validate_section "$section"
    if [[ "$execution_profile" != "track" ]]; then
      fail "3D 통합 지도 화면은 track 전용입니다. 평지 결과는 roka flat replay $section"
    fi
    view_directory="$active_map_root/$section"
    if [[ ! -s "$view_directory/map.pcd" ]]; then
      staging_directory="$active_map_root/.staging/$section"
      if [[ -s "$staging_directory/map.pcd" ]]; then
        view_directory="$staging_directory"
        printf '[ROKA][WARN] 정식 저장 지도 없음; 실패한 staging 자료를 진단용으로 표시합니다. 자율주행에는 사용되지 않습니다.\n'
      else
        fail "표시할 3D 지도가 없습니다: roka mapping $section 후 roka process $section 3d"
      fi
    fi
    printf '[ROKA] 실제 3D 지도 + 기록경로 + 차체 폭 + 2D 투영 + 위험도: %s\n' \
      "$view_directory"
    exec ros2 launch roka_nav2_bringup track_map_view.launch.py \
      bundle_directory:="$view_directory"
    ;;

  undo-review)
    require_profile
    exec ros2 service call /occupancy_cleanup/undo std_srvs/srv/Trigger "{}"
    ;;

  reset-review)
    require_profile
    exec ros2 service call /occupancy_cleanup/reset std_srvs/srv/Trigger "{}"
    ;;

  save-review)
    require_profile
    exec ros2 service call /occupancy_cleanup/save std_srvs/srv/Trigger "{}"
    ;;

  terrain-mode)
    require_profile
    terrain_mode="${1:-inspect}"
    case "$terrain_mode" in
      possible|blocked|inspect) ;;
      *) fail "영역 검토 모드는 possible, blocked 또는 inspect입니다: $terrain_mode" ;;
    esac
    exec ros2 service call "/terrain_review/mode_${terrain_mode}" \
      std_srvs/srv/Trigger "{}"
    ;;

  terrain-undo)
    require_profile
    exec ros2 service call /terrain_review/undo std_srvs/srv/Trigger "{}"
    ;;

  terrain-commit)
    require_profile
    exec ros2 service call /terrain_review/commit std_srvs/srv/Trigger "{}"
    ;;

  terrain-cancel)
    require_profile
    exec ros2 service call /terrain_review/cancel std_srvs/srv/Trigger "{}"
    ;;

  terrain-reset)
    require_profile
    exec ros2 service call /terrain_review/reset std_srvs/srv/Trigger "{}"
    ;;

  terrain-save)
    require_profile
    exec ros2 service call /terrain_review/save std_srvs/srv/Trigger "{}"
    ;;

  audit)
    require_profile
    section="${1:-section_1}"
    validate_section "$section"
    run_filtered "저장 센서 audit $section" \
      ros2 run roka_fast_lio_localization roka_bag_sensor_audit \
      "$active_map_root/$section/sensors" --require-diagnostics \
      --summary-only --output "benchmarks/${execution_profile}_${section}_sensor_contract.yaml"
    ;;

  *)
    usage >&2
    fail "알 수 없는 명령입니다: $command_name"
    ;;
esac
